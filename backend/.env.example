# Copy this file to .env and fill in real values. Never commit .env.

# Optional: if unset, the app automatically falls back to the deterministic
# heuristic policy parser (see app/policy_parser.py) so the project runs
# and is fully demoable with zero API key.
OPENAI_API_KEY=

# Optional: override if using an OpenAI-compatible provider (Azure OpenAI,
# OpenRouter, etc). Leave unset to use OpenAI's default endpoint.
OPENAI_BASE_URL=

# Optional: model name for policy parsing.
OPENAI_MODEL=gpt-4o-mini

# Optional: where JSON persistence writes policies.json. Defaults to
# backend/data/ if unset.
DATA_DIR=
